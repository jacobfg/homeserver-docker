{
  extends: [
    'config:best-practices',
    ':dependencyDashboard',
  ],
  separateMultipleMajor: true,
  baseBranchPatterns: [
    'main',
  ],
  labels: [
    'dependencies',
    'bot',
  ],
  enabled: true,
  enabledManagers: [
    'docker-compose',
    'github-actions',
    'custom.regex',
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
      enabled: true,
      matchPackageNames: [
        '*',
      ],
    },
    {
      groupName: 'README all minor and patch dependencies',
      groupSlug: 'README all-minor-patch',
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        '*',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/esphome/esphome',
      ],
      enabled: false,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'nodered/node-red',
      ],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-22-minimal$',
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
    {
      matchPackageNames: [
        'github.com/esphome/esphome',
      ],
      matchDatasources: [
        'github-releases',
      ],
      dependencyDashboardApproval: true,
      enabled: true,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^README\\.md$/',
      ],
      matchStrings: [
        ' github.com\\/(?<depName>.*) \\| (?<currentValue>v?\\d+\\.\\d+\\.\\d+) \\|',
      ],
      datasourceTemplate: 'github-releases',
    },
  ],
}
